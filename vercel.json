{
  "version": 2,

  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],

  "routes": [

    {
      "src": "/api/(.*)",
      "dest": "/api/server.js"
    },

    {
      "src": "/",
      "dest": "/public/index.html"
    },

    {
      "src": "/inventario",
      "dest": "/public/inventario.html"
    },

    {
      "src": "/movimientos",
      "dest": "/public/movimientos.html"
    },

    {
      "src": "/evidencias",
      "dest": "/public/evidencias.html"
    },

    {
      "src": "/auditoria",
      "dest": "/public/auditoria.html"
    },

    {
      "src": "/usuarios",
      "dest": "/public/usuarios.html"
    },

    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },

    {
      "src": "/script.js",
      "dest": "/public/script.js"
    }

  ]
}